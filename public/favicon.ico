<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="none">
  <rect width="100" height="100" rx="22" fill="#09090b" />
  <circle cx="50" cy="50" r="38" fill="#06b6d4" opacity="0.25" />
  <!-- Deep backdrop ore -->
  <path d="M 50,10 L 80,32 L 50,90 L 20,32 Z" fill="#0891b2" opacity="0.5" />
  <!-- Facets -->
  <path d="M 50,10 L 20,32 L 45,54 L 50,10" fill="#0369a1" stroke="#38bdf8" stroke-width="2" stroke-linejoin="round" />
  <path d="M 50,10 L 50,54 L 80,32 L 50,10" fill="#0e7490" stroke="#7dd3fc" stroke-width="2" stroke-linejoin="round" />
  <path d="M 20,32 L 50,90 L 45,54 L 20,32" fill="#0f172a" stroke="#0284c7" stroke-width="2" stroke-linejoin="round" />
  <path d="M 80,32 L 50,54 L 50,90 L 80,32" fill="#06b6d4" stroke="#e0f2fe" stroke-width="2" stroke-linejoin="round" />
  <!-- Inner glowing core seam -->
  <path d="M 50,26 L 45,54 L 50,90 L 50,26" fill="#ffffff" opacity="0.95" />
  <!-- Bright accent sparkles -->
  <circle cx="34" cy="22" r="3.5" fill="#ffffff" />
